{
  "name": "moh-fpincome",
  "version": "2.1.20",
  "description": "FPCare Income Review Web App",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcgov/MOH-FPC-Enrolment.git"
  },
  "homepage": "git+https://github.com/bcgov/MOH-FPC-Enrolment.git/fpincome/README.md",
  "main": "src/main.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --code-coverage --browsers=ChromeHeadless",
    "test-headless-firefox": "ng test --watch=false --code-coverage --browsers=FirefoxHeadless",
    "test:e2e": "start-server-and-test 'ng serve --port 4310' 4310 'cypress open --e2e --browser electron'",
    "test:e2e:headless": "start-server-and-test 'ng serve --port 4310' 4310 'cypress run'",
    "dev": "ng serve --host=0.0.0.0 -o",
    "prebuild": "node src/version.js",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "version": "node src/version.js && npm run changelog",
    "postversion": "git add . && git commit -m \"chore: commit changelog\"",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ng-select/ng-select": "^14.7.0",
    "blueimp-canvas-to-blob": "~3.14.0",
    "bootstrap": "^4.5.3",
    "date-fns": "^4.1.0",
    "font-awesome": "^4.7.0",
    "moh-common-lib-angular": "^2.1.0",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ngx-bootstrap": "^19.0.2",
    "ngx-mask": "^19.0.7",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/language-service": "^19.2.0",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.0",
    "angular-eslint": "19.8.1",
    "conventional-changelog-cli": "^2.1.1",
    "cypress": "^15.18.0",
    "eslint": "^9.28.0",
    "husky": "^4.3.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-firefox-launcher": "^2.1.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-spec-reporter": "0.0.32",
    "lint-staged": "^10.5.1",
    "prettier": "2.0.5",
    "start-server-and-test": "^3.0.11",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.33.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,ts,html,scss,md}": "prettier --write"
  }
}
