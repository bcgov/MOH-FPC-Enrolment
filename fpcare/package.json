{
  "name": "fpcare",
  "version": "4.2.5",
  "description": "FPCare Service Provider Web App",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/MOH-FPC-Enrolment.git"
  },
  "homepage": "https://my.gov.bc.ca/fpcare",
  "main": "server.js",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "ng serve --host=\"0.0.0.0\" -o",
    "dev-build": "ng build",
    "prebuild": "node ./src/version.js",
    "build": "ng build",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --code-coverage --browsers=ChromeHeadless",
    "test:e2e": "start-server-and-test 'ng serve --port 4302' 4302 'cypress open --e2e --browser electron'",
    "test:e2e:headless": "start-server-and-test 'ng serve --port 4302' 4302 'cypress run'",
    "version": "node ./src/version.js",
    "postversion": "git add . && git commit -m \"chore: commit version file\"",
    "test-version": "npm version minor -m 'TEST build: %s'",
    "prod-version": "npm version major -m 'PROD build: %s'",
    "push-version": "git push --follow-tags",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ng-select/ng-select": "^14.7.0",
    "bootstrap": "^4.3.1",
    "date-fns": "^4.1.0",
    "font-awesome": "^4.6.3",
    "js-md5": "^0.7.3",
    "moh-common-lib-angular": "^2.2.0",
    "moment": "^2.29.4",
    "mygovbc-bootstrap-theme": "^0.4.0",
    "ngx-bootstrap": "^19.0.2",
    "ngx-mask": "^19.0.7",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/language-service": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.0",
    "angular-eslint": "19.8.1",
    "cypress": "^15.18.0",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-spec-reporter": "0.0.32",
    "start-server-and-test": "^3.0.11",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.33.1"
  },
  "private": false
}
